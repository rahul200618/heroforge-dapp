# Copy to .env (inside backend/) and fill in. NEVER commit .env.

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=0xa574CbE7b3CD4e082D518141E64AF3e795dA487A
CHAIN_ID=11155111

# Block the contract was deployed in (see its creation transaction on Etherscan).
# Event indexing starts here.
START_BLOCK=0

# Dedicated testnet-only wallet for the backend. NOT your deployer / owner key.
GAME_MASTER_PRIVATE_KEY=your_backend_wallet_private_key_here

# Shared secret the game server sends in the X-API-Key header. Use a long random string.
MATCH_API_KEY=change_me_to_a_long_random_string

MAX_XP_PER_MATCH=100
ITEM_TYPES_ALLOWED=sword,shield,helmet
POLL_INTERVAL_SECONDS=5
LOG_CHUNK_BLOCKS=1000
MIN_GAS_BALANCE_ETH=0.01
CORS_ORIGIN=http://localhost:3000
DB_PATH=./data/heroforge.db
