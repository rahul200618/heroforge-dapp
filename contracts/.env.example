# Copy to .env and fill in. NEVER commit .env.

# Owner / deployer wallet (test wallet only, never one that holds real funds)
PRIVATE_KEY=your_private_key_here

SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Used by the original deploy script
GAME_MASTER_ADDRESS=your_game_master_address_here

# Used by scripts/set-game-master.js
CONTRACT_ADDRESS=0xa574CbE7b3CD4e082D518141E64AF3e795dA487A
NEW_GAME_MASTER_ADDRESS=your_backend_wallet_address_here
